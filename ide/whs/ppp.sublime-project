{
    "folders":
    [
        {
            "path": "../..",
            "folder_exclude_patterns": [ ".git", "../../ipd" ]
        }
    ],
    "settings":
     {
        "PyYapf":{
         "on_save": true
        },
        "project_environment": {
            "env": {
                "PYTHON": "/home/sheffler/sw/MambaForge/envs/ppp/bin/python"
            }
        }

    },
    "build_systems": [
        {
            "name": "ide tests",
            "shell_cmd": "cd $folder; PYTHONPATH=../.. \\$PYTHON lib/ipd/ipd/tools/run_tests_on_file.py ppp ipd $file 2>&1 | tee $folder/ide/sublime_build.log",
            "file_regex": "^\\s*File \"(...*?)\", line ([0-9]*)"
        },
        {
            "name": "ide tests pytest",
            "shell_cmd": "cd $folder; PYTHONPATH=../.. \\$PYTHON lib/ipd/ipd/tools/run_tests_on_file.py ppp ipd $file --pytest 2>&1 | tee $folder/ide/sublime_build.log",
            "file_regex": "^\\s*File \"(...*?)\", line ([0-9]*)"
        },
        {
            "name": "ruff",
            "shell_cmd": "cd $folder && PYTHONPATH=. ruff check  2>&1 | tee ide/sublime_build.log",
            "file_regex": "^\\s*File \"(...*?)\", line ([0-9]*)"
        },
        {
            "name": "pytest",
            "shell_cmd": "cd $folder && PYTHONPATH=. \\$PYTHON -m pytest  -x 2>&1 | tee ide/sublime_build.log",
            "file_regex": "^\\s*File \"(...*?)\", line ([0-9]*)"
        },
        {
            "name": "test ppp plugin",
            "shell_cmd": "cd $folder && PYTHONPATH=. QT_QPA_PLATFORM=xcb /home/sheffler/sw/MambaForge/envs/pymol/bin/pymol 2>&1 | tee ide/sublime_build.log",
            "file_regex": "^\\s*File \"(...*?)\", line ([0-9]*)"
        },
        {
            "name": "test ppp server",
            "shell_cmd": "cd $folder && PYTHONPATH=. /home/sheffler/sw/MambaForge/envs/ppp/bin/python ppp/tests/server/test_pppapi.py 2>&1 | tee ide/sublime_build.log",
            "file_regex": "^\\s*File \"(...*?)\", line ([0-9]*)"
        },
        {
            "name": "test crud",
            "shell_cmd": "cd $folder && PYTHONPATH=. \\$PYTHON ipd/tests/crud/test_crud.py 2>&1 | tee ide/sublime_build.log",
            "file_regex": "^\\s*File \"(...*?)\", line ([0-9]*)"
        },
        {
            "name": "test citool",
            "shell_cmd": "cd $folder && PYTHONPATH=. \\$PYTHON -m ipd ci tests ruff 2>&1 | tee ide/sublime_build.log",
            "file_regex": "^\\s*File \"(...*?)\", line ([0-9]*)"
        },
        {
            "name": "test pkgtool",
            "shell_cmd": "cd $folder && PYTHONPATH=. \\$PYTHON -m ipd.tools.pkgtool 2>&1 | tee ide/sublime_build.log",
            "file_regex": "^\\s*File \"(...*?)\", line ([0-9]*)"
        },
        {
            "name": "runtest.py",
            "shell_cmd": "cd $folder && PYTHONPATH=../.. \\$PYTHON ipd/tools/run_tests_on_file.py ipd $file &> ide/sublime_build.log",
            "file_regex": "^\\s*File \"(...*?)\", line ([0-9]*)"
        },
        {
            "name": "test bunch",
            "shell_cmd": "cd $folder && PYTHONPATH=. /home/sheffler/sw/MambaForge/envs/TEST/bin/python ipd/tests/dev/test_bunch.py &> ide/sublime_build.log",
            "file_regex": "^\\s*File \"(...*?)\", line ([0-9]*)"
        },
        {
            "name": "test state",
            "shell_cmd": "cd $folder && PYTHONPATH=. /home/sheffler/sw/MambaForge/envs/TEST/bin/python ipd/tests/dev/test_state.py &> ide/sublime_build.log",
            "file_regex": "^\\s*File \"(...*?)\", line ([0-9]*)"
        },
        {
            "name": "pymol",
            "shell_cmd": "cd $folder; QT_QPA_PLATFORM=xcb /home/sheffler/sw/MambaForge/envs/basic_pymol/bin/pymol",
            "file_regex": "^\\s*File \"(...*?)\", line ([0-9]*)"
        }
    ]
}
